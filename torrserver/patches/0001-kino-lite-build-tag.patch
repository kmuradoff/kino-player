diff --git a/server/web/extras_full.go b/server/web/extras_full.go
new file mode 100644
index 0000000..66e9893
--- /dev/null
+++ b/server/web/extras_full.go
@@ -0,0 +1,34 @@
+//go:build !kino
+
+package web
+
+import (
+	"github.com/gin-gonic/gin"
+
+	"server/mcp"
+	"server/settings"
+	"server/torrfs/fuse"
+	"server/torrfs/webdav"
+	"server/web/auth"
+	"server/web/msx"
+	"server/web/pages"
+)
+
+// setupExtras mounts what the lite build (tag kino) leaves out: MCP, MSX, the web UI,
+// WebDAV, FUSE and Swagger.
+func setupExtras(route *gin.Engine) {
+	mcp.Mount(route.Group("/", auth.CheckAuth()))
+	msx.SetupRoute(route)
+	pages.SetupRoute(route)
+	if settings.Args.WebDAV {
+		webdav.MountWebDAV(route)
+	}
+	// Auto-mount FUSE filesystem if enabled
+	fuse.FuseAutoMount()
+	route.GET("/swagger/*any", swaggerHandler())
+}
+
+func stopExtras() {
+	// Unmount FUSE filesystem if mounted
+	fuse.FuseCleanup()
+}
