<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <!-- Сюда движок (Media3 или VLC) кладёт свою картинку -->
    <FrameLayout
        android:id="@+id/video"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Лёгкое затемнение на паузе -->
    <View
        android:id="@+id/dim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:background="#8C000000" />

    <!-- ── Панели управления ─────────────────────────────────────────── -->
    <FrameLayout
        android:id="@+id/controls"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0">

        <View
            android:layout_width="match_parent"
            android:layout_height="240dp"
            android:layout_gravity="top"
            android:background="@drawable/scrim_top" />

        <View
            android:layout_width="match_parent"
            android:layout_height="340dp"
            android:layout_gravity="bottom"
            android:background="@drawable/scrim_bottom" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:gravity="top"
            android:orientation="horizontal"
            android:paddingStart="64dp"
            android:paddingTop="44dp"
            android:paddingEnd="64dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="-0.01"
                    android:maxLines="1"
                    android:shadowColor="#80000000"
                    android:shadowRadius="12"
                    android:textColor="@color/text"
                    android:textSize="34sp" />

                <TextView
                    android:id="@+id/subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/text_dim"
                    android:textSize="17sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/clock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-light"
                    android:textColor="@color/text"
                    android:textSize="30sp" />

                <TextView
                    android:id="@+id/net"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_faint"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:orientation="vertical"
            android:paddingStart="64dp"
            android:paddingEnd="64dp"
            android:paddingBottom="40dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="bottom"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/position"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:fontFeatureSettings="tnum"
                    android:textColor="@color/text"
                    android:textSize="22sp" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/remaining"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFeatureSettings="tnum"
                    android:textColor="@color/text_dim"
                    android:textSize="18sp" />
            </LinearLayout>

            <com.xgimiru.player.ProgressView
                android:id="@+id/progress"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginTop="2dp" />

            <LinearLayout
                android:id="@+id/chips"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/hint"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:text="▼  звук · субтитры · экран"
                    android:textColor="@color/text_faint"
                    android:textSize="15sp" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <!-- Пауза / воспроизведение — вспышка по центру -->
    <com.xgimiru.player.StateBadge
        android:id="@+id/badge"
        android:layout_width="132dp"
        android:layout_height="132dp"
        android:layout_gravity="center"
        android:alpha="0" />

    <!-- Загрузка -->
    <LinearLayout
        android:id="@+id/buffering"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:visibility="gone">

        <com.xgimiru.player.BufferRing
            android:layout_width="84dp"
            android:layout_height="84dp" />

        <TextView
            android:id="@+id/bufferText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:fontFamily="sans-serif-medium"
            android:shadowColor="#CC000000"
            android:shadowRadius="10"
            android:text="Загрузка"
            android:textColor="@color/text"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/bufferDetail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:shadowColor="#CC000000"
            android:shadowRadius="10"
            android:textColor="@color/text_dim"
            android:textSize="15sp" />
    </LinearLayout>

    <!-- «Продолжаем с …» -->
    <LinearLayout
        android:id="@+id/toast"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="140dp"
        android:alpha="0"
        android:background="@drawable/card_bg"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingTop="16dp"
        android:paddingEnd="28dp"
        android:paddingBottom="16dp">

        <TextView
            android:id="@+id/toastTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/text"
            android:textSize="19sp" />

        <TextView
            android:id="@+id/toastHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/text_dim"
            android:textSize="15sp" />
    </LinearLayout>

    <!-- Следующая серия -->
    <LinearLayout
        android:id="@+id/next"
        android:layout_width="440dp"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="64dp"
        android:layout_marginBottom="200dp"
        android:background="@drawable/card_bg"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingTop="22dp"
        android:paddingEnd="28dp"
        android:paddingBottom="22dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/nextCaption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.12"
            android:text="СЛЕДУЮЩАЯ СЕРИЯ"
            android:textColor="@color/accent_warm"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/nextTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="2"
            android:textColor="@color/text"
            android:textSize="22sp" />

        <com.xgimiru.player.ProgressView
            android:id="@+id/nextProgress"
            android:layout_width="match_parent"
            android:layout_height="20dp"
            android:layout_marginTop="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="OK — смотреть сейчас   ·   Назад — скрыть"
            android:textColor="@color/text_faint"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Ошибка -->
    <LinearLayout
        android:id="@+id/error"
        android:layout_width="620dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/card_bg"
        android:orientation="vertical"
        android:padding="32dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="Не получилось воспроизвести"
            android:textColor="@color/text"
            android:textSize="24sp" />

        <TextView
            android:id="@+id/errorText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textColor="@color/text_dim"
            android:textSize="16sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="OK — попробовать ещё раз   ·   Назад — выйти"
            android:textColor="@color/text_faint"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Панель: звук, субтитры, скорость, экран -->
    <FrameLayout
        android:id="@+id/panel"
        android:layout_width="480dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:background="@drawable/panel_bg"
        android:translationX="480dp"
        android:visibility="invisible">

        <ScrollView
            android:id="@+id/panelScroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingTop="48dp"
            android:paddingBottom="48dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/panelList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="28dp"
                android:paddingEnd="28dp" />
        </ScrollView>
    </FrameLayout>
</FrameLayout>
