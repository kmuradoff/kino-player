<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <gradient android:angle="315" android:startColor="#33FF7A59" android:endColor="#1AFFB561" />
            <corners android:radius="20dp" />
            <stroke android:width="2dp" android:color="#FFFF9A6B" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="#14FFFFFF" />
            <corners android:radius="20dp" />
            <stroke android:width="1dp" android:color="#14FFFFFF" />
        </shape>
    </item>
</selector>
